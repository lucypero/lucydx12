[
	{
		"label": "A - build debug",
		"command": "raddbg.exe --ipc kill_all && odin build lucy3d -debug -out:lucydx12.exe -linker:radlink -vet-packages:main,sluggish_generator -vet-unused-variables -vet-shadowing -vet-using-stmt -vet-cast && raddbg --ipc run",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"hide": "on_success",
		"shell": {
			"program": "cmd",
		},
		"show_summary": true,
		"show_command": true,
		"save": "all",
	},
	{
		"label": "vet everything",
		"command": "odin check lucy3d -debug -define:PROFILE=true -vet-packages:main,sluggish_generator -vet-unused-variables -vet-shadowing -vet-using-stmt -vet-cast -vet-unused-procedures -vet-unused-imports",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"hide": "on_success",
		"shell": {
			"program": "cmd",
		},
		"show_summary": true,
		"show_command": true,
		"save": "all",
	},
	{
		"label": "build sluggish generator",
		"command": "odin build lucy3d/sluggish_generator -debug -build-mode:dynamic -linker:radlink -vet-packages:sluggish_generator -vet-unused-variables -vet-shadowing -vet-using-stmt -vet-cast",
		"save": "all",
	},
	{
		"label": "build profile - debug",
		"command": "odin build lucy3d -debug -out:lucydx12.exe -linker:radlink -vet-shadowing -define:PROFILE=true",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"hide": "never",
		"shell": {
			"program": "cmd",
		},
		"show_summary": true,
		"show_command": true,
		"save": "all",
	},
	{
		"label": "build opt",
		"command": "odin build lucy3d -o:speed -out:lucydx12.exe -linker:radlink -vet-shadowing",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
		"hide": "on_success",
		"shell": {
			"program": "cmd",
		},
		"show_summary": true,
		"show_command": true,
		"save": "all",
	},
	{
		"label": "run debug",
		"command": "odin run lucy3d -debug -out:lucydx12.exe -linker:radlink -keep-executable -vet-packages:main,sluggish_generator -vet-unused-variables -vet-shadowing -vet-using-stmt -vet-cast",
		"use_new_terminal": false,
		"allow_concurrent_runs": false,
		"reveal": "always",
